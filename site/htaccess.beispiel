# Passwortschutz fuer die ganze Seite (preise.kaipel.at).
# Wird beim Deploy als .htaccess hochgeladen (nur wenn das Secret HTPASSWD_PFAD gesetzt ist).
# Die .htpasswd legt passwort-setzen.ps1 an; Apache liefert .ht*-Dateien grundsaetzlich nicht aus.
AuthType Basic
AuthName "Preis-Tracker"
AuthUserFile __HTPASSWD_PFAD__
Require valid-user

# Daten nicht cachen, damit der taegliche Stand sofort sichtbar ist
<IfModule mod_headers.c>
    <FilesMatch "\.(js|html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Komprimierung (grosse Daten-Dateien)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html application/javascript text/javascript application/json text/css
</IfModule>
